<!DOCTYPE html>
<html lang="es" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ title or site.name }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}/assets/images/{{ ogImage }}" />{% endif %}
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">La Brisa</a>
    <button class="nav-toggle" aria-label="Menú" onclick="this.classList.toggle('open');document.querySelector('.nav-links').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links">
      <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Inicio</a></li>
      <li><a href="/about/" {% if page.url == "/about/" %}class="active"{% endif %}>El espacio</a></li>
      <li><a href="/contacto/" {% if page.url == "/contacto/" %}class="active"{% endif %}>Contacto</a></li>
    </ul>
  </div>
</nav>

{{ content | safe }}

<footer class="site-footer">
  <p>&copy; {{ site.name }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</footer>

</body>
</html>
